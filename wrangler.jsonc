{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinx-relay",
  "main": "src/relay-worker.js",
  "compatibility_date": "2026-11-25",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PinxRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PinxRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://punxcore058.github.io"
  }
}
