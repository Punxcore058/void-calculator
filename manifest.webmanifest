{
  "name": "Void Calculator",
  "short_name": "Calculator",
  "start_url": "./",
  "scope": "./",
  "display_override": ["fullscreen", "standalone"],
  "display": "standalone",
  "background_color": "#090909",
  "theme_color": "#090909",
  "icons": [
    {
      "src": "./apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
